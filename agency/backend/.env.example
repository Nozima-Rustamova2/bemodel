SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///./data/agency.db
UPLOAD_DIR=./static/uploads
CORS_ORIGINS=http://localhost:3000
FIRST_ADMIN_EMAIL=admin@agency.com
FIRST_ADMIN_PASSWORD=changeme123

# Media storage: "local" (disk, default for dev) or "r2" (Cloudflare R2, recommended for prod)
STORAGE_BACKEND=local
# Only needed when STORAGE_BACKEND=r2 (see https://developers.cloudflare.com/r2/)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Public URL of the frontend, used to build the "View in admin panel" link in Telegram notifications
FRONTEND_URL=http://localhost:3000

# Telegram notifications for new "Become a Model" / Contact submissions.
# Create a bot via @BotFather in Telegram to get a token, then message the bot
# once and check https://api.telegram.org/bot<TOKEN>/getUpdates for your chat_id.
# Leave both blank to disable Telegram notifications entirely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
