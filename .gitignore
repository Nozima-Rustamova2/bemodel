# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
venv/

# Backend runtime data / secrets
agency/backend/.env
agency/backend/data/*.db
agency/backend/data/*.db-journal
agency/backend/static/uploads/*
!agency/backend/static/uploads/.gitkeep
agency/backend/backend.log

# Node / Next.js
node_modules/
.next/
out/
agency/frontend/.env.local
agency/frontend/frontend.log
npm-debug.log*

# Editors / OS
.DS_Store
Thumbs.db

# Debug/scratch logs from local tunnel testing
/tunnel.log
/tunnel-backend.log

# graphify knowledge-graph output (regenerated by /graphify; includes caches,
# transcripts and a 2.7MB graph.html — all derived from the repo itself)
graphify-out/

# Dev-server logs written by local run scripts
*dev-backend.log
*dev-backend.err.log
*dev-frontend.log
